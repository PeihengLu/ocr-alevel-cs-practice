# MySQL connection (same knobs for Homebrew dev AND future bundled mysqld).
# Shipped apps will start a portable mysqld and connect here — students need no brew/Docker.
#
# Force JSON-only (skip MySQL probe):
#   PORTABLE_LEETCODE_STORAGE=json
#   # or MYSQL_DISABLED=1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=portable
MYSQL_PASSWORD=portable
MYSQL_DATABASE=portable_leetcode

# Future bundled sidecar data dir (defaults to Electron userData/mysql-data)
# MYSQL_DATA_DIR=/absolute/path/to/mysql-data

# Prefer spawning bundled mysqld when packaging has placed vendor/mysql or resources/mysql
# MYSQL_PREFER_BUNDLED=1
