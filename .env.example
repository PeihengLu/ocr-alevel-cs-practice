# Optional MySQL connection for app storage (questions, packs, attempts).
# If MySQL is unreachable, the app falls back to a JSON bank under Electron userData.
#
# Force JSON-only (skip MySQL probe):
#   PORTABLE_LEETCODE_STORAGE=json
#   # or MYSQL_DISABLED=1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=portable
MYSQL_PASSWORD=portable
MYSQL_DATABASE=portable_leetcode
