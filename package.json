{
  "name": "portable-leetcode",
  "version": "0.1.0",
  "description": "Offline plug-and-play coding practice — SQL demos and student practice (Teacher/Student editions from one codebase)",
  "main": "./out/main/index.js",
  "author": "PeihengLu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:student": "cross-env VITE_EDITION=student electron-vite dev",
    "dev:teacher": "cross-env VITE_EDITION=teacher electron-vite dev",
    "build": "electron-vite build",
    "build:student": "cross-env VITE_EDITION=student electron-vite build",
    "build:teacher": "cross-env VITE_EDITION=teacher electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "sample:pack": "node scripts/build-sample-pack.mjs",
    "test:practice": "node --experimental-strip-types scripts/smoke-practice.mts",
    "vendor:mysql": "node scripts/stage-mysql-mac.mjs",
    "pack:mac:teacher": "npm run vendor:mysql && npm run sample:pack && npm run build:teacher && electron-builder --mac dir --config.productName=\"PortableLeetcode Teacher\" --config.appId=com.portableleetcode.teacher --config.directories.output=release/teacher-mac",
    "pack:mac:student": "npm run vendor:mysql && npm run sample:pack && npm run build:student && electron-builder --mac dir --config.productName=\"PortableLeetcode Student\" --config.appId=com.portableleetcode.student --config.directories.output=release/student-mac",
    "pack:mac": "npm run pack:mac:teacher",
    "pack:win": "node scripts/pack-win-stub.mjs",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "mysql2": "^3.24.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.portableleetcode.app",
    "productName": "PortableLeetcode",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/mysql",
        "to": "mysql",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sql",
        "to": "sql",
        "filter": [
          "**/*.sql"
        ]
      },
      {
        "from": "samples",
        "to": "samples",
        "filter": [
          "**/*.plpack"
        ]
      },
      {
        "from": "content",
        "to": "content",
        "filter": [
          "**/*.plpack"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
