{
  "name": "portable-leetcode",
  "version": "0.2.0",
  "description": "Offline plug-and-play coding practice for SQL and Python",
  "main": "./out/main/index.js",
  "author": "PeihengLu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "sample:pack": "node scripts/build-sample-pack.mjs",
    "test:practice": "node --experimental-strip-types scripts/smoke-practice.mts && node --experimental-strip-types scripts/smoke-python.mts && node --experimental-strip-types scripts/smoke-sql.mts",
    "pack:mac": "npm run sample:pack && npm run build && electron-builder --mac dir",
    "pack:win": "npm run sample:pack && npm run build && electron-builder --win dir portable --x64",
    "dist:win": "npm run pack:win",
    "deploy": "node scripts/deploy.mjs",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "codemirror": "^6.0.2",
    "jszip": "^3.10.2",
    "pyodide": "^314.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.portableleetcode.app",
    "productName": "PortableLeetcode",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "out/**/*",
      "!node_modules/pyodide/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/sql.js/dist/*.wasm"
    ],
    "extraResources": [
      {
        "from": "sql",
        "to": "sql",
        "filter": [
          "**/*.sql"
        ]
      },
      {
        "from": "samples/sql-basics",
        "to": "samples/sql-basics",
        "filter": [
          "manifest.json",
          "questions/**/*.json",
          "sql/**/*.sql"
        ]
      },
      {
        "from": "content",
        "to": "content",
        "filter": [
          "**/*.plpack"
        ]
      },
      {
        "from": "src/main/python/python-run.mjs",
        "to": "python/python-run.mjs"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sqlite/sql-wasm.wasm"
      },
      {
        "from": "node_modules/pyodide",
        "to": "pyodide",
        "filter": [
          "pyodide.mjs",
          "pyodide.asm.mjs",
          "pyodide.asm.wasm",
          "python_stdlib.zip",
          "pyodide-lock.json",
          "package.json"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
